+libs = ['kawpow', 'keccak']
+# When building for Android via python-for-android, link explicitly
+# against the C++ runtime shipped in the APK so __gxx_personality_v0
+# and friends are resolved at dlopen() time.
+if os.environ.get("KAWPOW_ANDROID_BUILD") == "1":
+    libs.append("c++_shared")
+
+ffibuilder.set_source(
+    "_kawpow",
+    r"""
+    #include <kawpow/keccak.h>
+    #include <kawpow/kawpow.h>
+     """,
+    include_dirs=['include'],
+    libraries=libs,
+)
